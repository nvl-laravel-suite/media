{
    "name": "nvl/media",
    "description": "Laravel media uploads, associations, variations and localized metadata",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "media",
        "uploads",
        "images",
        "translation"
    ],
    "require": {
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8.2 || ^8.0",
        "guzzlehttp/psr7": "^2.7",
        "laravel/framework": "^12.0 || ^13.0",
        "league/flysystem": "^3.25",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^6.0.1",
        "nvl/filterable": "^6.0",
        "nvl/translatable": "^6.0",
        "php": "^8.4",
        "spatie/image": "^3.0",
        "spatie/laravel-data": "^4.23",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0"
    },
    "require-dev": {
        "aws/aws-sdk-php": "^3.322.9",
        "ext-gd": "*",
        "ext-pcntl": "*",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mockery/mockery": "^1.6",
        "nvl/ownership": "^6.0.1",
        "nvl/tenancy": "^6.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spatie/typescript-transformer": "^3.3",
        "symfony/process": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Media\\": "src/",
            "Nvl\\Media\\Database\\Factories\\": "database/factories/",
            "Nvl\\Media\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Media\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Feature/NvlMediaCapabilityTest.php"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "dependencies": "composer-dependency-analyser --config composer-dependency-analyser.php",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "manifest:validate": "@composer validate --strict",
        "quality": [
            "@manifest:validate",
            "@format:test",
            "@analyse",
            "@dependencies",
            "@security:audit",
            "@test"
        ],
        "security:audit": "@composer audit --no-interaction",
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Media\\Providers\\MediaServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/composer-dependency-analyser.php",
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "aws/aws-sdk-php": "Built-in S3 uploads and multipart storage: composer require league/flysystem-aws-s3-v3:^3.0 aws/aws-sdk-php:^3.322.9 --with-all-dependencies.",
        "league/flysystem-aws-s3-v3": "Built-in S3 uploads and multipart storage: composer require league/flysystem-aws-s3-v3:^3.0 aws/aws-sdk-php:^3.322.9 --with-all-dependencies.",
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts.",
        "nvl/tenancy": "Temporary legacy tenancy bridge for existing tenant installations; native ownership does not require it.",
        "spatie/typescript-transformer": "Consume the declared TypeScript attributes and metadata (^3.3); Core retains the runtime transformation engine."
    },
    "conflict": {
        "aws/aws-sdk-php": "<3.322.9 || >=4.0",
        "league/flysystem-aws-s3-v3": "<3.0 || >=4.0",
        "nvl/ownership": "<6.0.1 || >=7.0",
        "nvl/tenancy": "<6.0 || >=7.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/media",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/media",
        "docs": "https://github.com/nvl-laravel-suite/media#readme",
        "issues": "https://github.com/nvl-laravel-suite/media/issues",
        "security": "https://github.com/nvl-laravel-suite/media/security/policy"
    }
}
